# Okta authorization server issuer. The default Okta authorization server is
# usually https://YOUR_OKTA_DOMAIN/oauth2/default
OKTA_ISSUER=https://YOUR_OKTA_DOMAIN/oauth2/default
OKTA_CLIENT_ID=YOUR_CLIENT_ID
OKTA_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Generate at least 32 random bytes, for example: openssl rand -base64 48
OKTA_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Comma-separated ID-token claims whose string values become app permissions.
# Configure matching claims on the Okta authorization server/app integration.
OKTA_PERMISSION_CLAIMS=okta_groups,groups,roles,permissions

# Server-only GitHub App installation used by the CMS gateway. Install the App
# only on t1mlopez/latediagnosed-site with Contents: read/write. Never expose
# these values to browser code or commit a real private key.
GITHUB_APP_ID=YOUR_GITHUB_APP_ID
GITHUB_APP_INSTALLATION_ID=YOUR_GITHUB_APP_INSTALLATION_ID
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_GITHUB_APP_PRIVATE_KEY\n-----END PRIVATE KEY-----"
