{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "latediagnosed-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "latediagnosed.org", "custom_domain": true },
    { "pattern": "www.latediagnosed.org/*", "zone_name": "latediagnosed.org" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
