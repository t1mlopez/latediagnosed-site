---
import PublicLayout from "../layouts/PublicLayout.astro";

const donationUrl = "https://givebutter.com/late-diagnosed-donations-3akmpq";
const contactEmail = "info@latediagnosed.org";

const involvementCards = [
  {
    href: "#surveys",
    icon: "clipboard-list",
    title: "Take a Survey",
    description: "Turn lived experience into data.",
  },
  {
    href: "#volunteer",
    icon: "users",
    title: "Volunteer",
    description: "Put your skills toward something meaningful.",
  },
  {
    href: "#donate",
    icon: "heart",
    title: "Donate",
    description: "Help fund resources, research, and outreach.",
  },
];

const volunteerSkills = [
  "Writing",
  "Research",
  "Design",
  "Technology",
  "Accessibility",
  "Social Media",
  "Data",
  "Community",
  "Fundraising",
  "Education",
  "Events",
  "Outreach",
];

const researchMailto = `mailto:${contactEmail}?subject=LateDiagnosed.org%20Survey%20Interest`;
const volunteerMailto = `mailto:${contactEmail}?subject=Volunteer%20with%20LateDiagnosed.org`;
const expertiseMailto = `mailto:${contactEmail}?subject=Offer%20Professional%20Expertise`;
---

<PublicLayout
  title="Get Involved | Late Diagnosed"
  description="Give your time, experience, expertise, or financial support to help LateDiagnosed.org reach more people."
>
  <main class="get-involved bg-white text-slate-700">
    <header class="relative overflow-hidden bg-[#342563] text-white">
      <div class="relative z-10 mx-auto flex min-h-[48vh] max-w-6xl flex-col justify-center px-6 py-24 md:min-h-[56vh]">
        <h1 class="font-heading max-w-4xl text-4xl font-bold leading-tight text-white md:text-5xl">
          There’s more than one way to make a difference.
        </h1>
      </div>
    </header>

    <section class="relative h-[32vh] min-h-[220px] max-h-[360px] w-full overflow-hidden" aria-label="Misty autumn forest">
      <picture>
        <source
          media="(max-width: 767px)"
          srcset="/images/hero-forest-1280.webp"
          type="image/webp"
        />
        <img
          class="absolute inset-0 h-full w-full object-cover object-center"
          src="/images/hero-forest-2560.webp"
          alt="Sunlight filtering through a misty autumn forest"
          width="2560"
          height="1920"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </section>

    <section id="ways" class="scroll-mt-24 bg-[#faf9fc] px-6 py-20 md:py-24">
      <div class="mx-auto max-w-6xl">
        <div class="mb-10">
          <h2 class="font-heading text-3xl font-bold text-[#1e2a5e] md:text-4xl">How would you like to get involved?</h2>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {involvementCards.map((card) => (
            <a href={card.href} class="group rounded-2xl border border-slate-200 bg-white p-6 no-underline shadow-sm transition duration-200 hover:-translate-y-1 hover:border-purple-200 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#4a2068]">
              <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-[#f3eef7] text-[#4a2068] transition group-hover:bg-[#4a2068] group-hover:text-white">
                <i data-lucide={card.icon} class="h-5 w-5"></i>
              </div>
              <h3 class="mb-2 text-xl font-bold text-[#1e2a5e]">{card.title}</h3>
              <p class="mb-4 text-sm leading-6 text-slate-600">{card.description}</p>
              <span class="text-sm font-bold text-[#4a2068]">Explore <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="surveys" class="scroll-mt-24 px-6 py-20 md:py-28">
      <div class="mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.16em] text-[#4a2068]">Community data</p>
          <h2 class="font-heading mb-5 text-3xl font-bold text-[#1e2a5e] md:text-5xl">Your experience becomes evidence.</h2>
          <p class="mb-5 text-lg leading-8 text-slate-700">
            One story can help someone feel understood. Hundreds or thousands of stories can reveal a pattern.
          </p>
          <p class="mb-7 text-base leading-7 text-slate-600">
            Our surveys help us understand what happens before, during, and after late diagnosis — including diagnosis pathways, burnout, skill regression, relationships, work, healthcare, support systems, identity, and what actually helped.
          </p>
          <a href={researchMailto} class="inline-flex items-center gap-2 rounded-lg bg-[#4a2068] px-6 py-3 font-bold text-white no-underline transition hover:-translate-y-0.5 hover:shadow-lg">
            Contribute to Our Research <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="space-y-5">
          <div class="flex aspect-[16/9] items-center justify-center rounded-3xl border-2 border-dashed border-purple-200 bg-gradient-to-br from-[#faf7fc] to-[#eef1f8] p-8 text-center">
            <div class="max-w-md">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-white text-[#4a2068] shadow-sm">
                <i data-lucide="image" class="h-5 w-5"></i>
              </div>
              <p class="mb-2 text-sm font-bold uppercase tracking-[0.14em] text-[#4a2068]">Image placeholder</p>
              <p class="mb-0 text-sm leading-6 text-slate-600">
                Suggested: a real community member completing a survey, or a subtle editorial image showing many individual voices becoming one shared set of insights. Avoid generic charts or clinical stock photography.
              </p>
            </div>
          </div>

          <div class="rounded-3xl border border-purple-100 bg-[#f8f5fa] p-6 md:p-8">
            <div class="grid gap-3 md:grid-cols-4 md:items-stretch">
              {[
                ["01", "Your Experience"],
                ["02", "Community Data"],
                ["03", "Better Resources"],
                ["04", "Greater Awareness"],
              ].map(([number, label], index) => (
                <div class="relative rounded-2xl bg-white p-5 text-center shadow-sm">
                  <div class="mb-2 text-xs font-bold tracking-[0.18em] text-purple-500">{number}</div>
                  <div class="text-sm font-bold leading-5 text-[#1e2a5e]">{label}</div>
                  {index < 3 && <span class="absolute -right-3 top-1/2 hidden -translate-y-1/2 text-xl font-bold text-purple-300 md:block" aria-hidden="true">→</span>}
                </div>
              ))}
            </div>
            <p class="mb-0 mt-6 text-sm leading-6 text-slate-600">
              We use aggregated community insight to identify patterns, shape educational resources, support outreach, guide future programs, and tell the story of late diagnosis with data behind it.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="volunteer" class="scroll-mt-24 bg-[#f7f8fb] px-6 py-20 md:py-28">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr]">
          <div>
            <div class="mb-7 flex flex-wrap gap-2.5">
              {volunteerSkills.map((skill) => (
                <span class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm">{skill}</span>
              ))}
            </div>

            <div class="flex aspect-[4/3] items-center justify-center rounded-3xl border-2 border-dashed border-slate-300 bg-white/70 p-7 text-center">
              <div class="max-w-sm">
                <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-[#f3eef7] text-[#4a2068]">
                  <i data-lucide="image" class="h-5 w-5"></i>
                </div>
                <p class="mb-2 text-sm font-bold uppercase tracking-[0.14em] text-[#4a2068]">Image placeholder</p>
                <p class="mb-0 text-sm leading-6 text-slate-600">
                  Suggested: candid collaboration — someone editing, designing, coding, planning, or meeting with another volunteer. It should feel like useful work being done, not a posed “teamwork” photo.
                </p>
              </div>
            </div>
          </div>

          <div>
            <p class="mb-3 text-sm font-bold uppercase tracking-[0.16em] text-[#4a2068]">Volunteer</p>
            <h2 class="font-heading mb-5 text-3xl font-bold text-[#1e2a5e] md:text-5xl">You already have something we need.</h2>
            <p class="mb-5 text-lg leading-8 text-slate-700">
              You do not need to work in healthcare or neurodiversity to contribute something meaningful.
            </p>
            <p class="mb-7 text-base leading-7 text-slate-600">
              Some volunteers may join an ongoing team. Others may contribute a few hours to a single project. We want to make room for both.
            </p>
            <div class="flex flex-wrap gap-3">
              <a href={volunteerMailto} class="rounded-lg bg-[#1e2a5e] px-6 py-3 font-bold text-white no-underline transition hover:-translate-y-0.5 hover:shadow-lg">Explore Volunteer Opportunities</a>
              <a href={expertiseMailto} class="rounded-lg border border-[#1e2a5e]/20 bg-white px-6 py-3 font-bold text-[#1e2a5e] no-underline transition hover:border-[#1e2a5e]/40 hover:shadow-md">Offer Your Expertise</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="donate" class="scroll-mt-24 relative overflow-hidden bg-[#1e2a5e] px-6 py-20 text-white md:py-28">
      <div class="absolute inset-y-0 right-0 w-1/2 bg-gradient-to-l from-[#4a2068]/45 to-transparent" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl">
        <div class="mb-12 max-w-3xl">
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.16em] text-purple-200">Donate</p>
          <h2 class="font-heading mb-5 text-3xl font-bold text-white md:text-5xl">Help us reach the next person who’s still looking for answers.</h2>
          <p class="text-lg leading-8 text-white/80">
            Financial support helps us build useful resources, learn from the community, and put that knowledge in front of more people.
          </p>
        </div>

        <div class="mb-10 grid gap-4 md:grid-cols-3">
          <div class="rounded-2xl border border-white/15 bg-white/10 p-6">
            <div class="mb-3 text-sm font-bold uppercase tracking-[0.14em] text-purple-200">Create</div>
            <h3 class="mb-2 text-xl font-bold text-white">Free educational resources</h3>
            <p class="mb-0 text-sm leading-6 text-white/70">Guides, articles, tools, and practical information people can use without a paywall.</p>
          </div>
          <div class="rounded-2xl border border-white/15 bg-white/10 p-6">
            <div class="mb-3 text-sm font-bold uppercase tracking-[0.14em] text-purple-200">Learn</div>
            <h3 class="mb-2 text-xl font-bold text-white">Community surveys & research</h3>
            <p class="mb-0 text-sm leading-6 text-white/70">Collecting lived-experience data so recurring patterns are harder to overlook.</p>
          </div>
          <div class="rounded-2xl border border-white/15 bg-white/10 p-6">
            <div class="mb-3 text-sm font-bold uppercase tracking-[0.14em] text-purple-200">Reach</div>
            <h3 class="mb-2 text-xl font-bold text-white">Awareness & outreach</h3>
            <p class="mb-0 text-sm leading-6 text-white/70">Helping information reach late-diagnosed adults, families, professionals, and communities.</p>
          </div>
        </div>

        <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
          <a href={donationUrl} target="_blank" rel="noopener noreferrer" class="inline-block w-fit rounded-lg bg-white px-7 py-3.5 font-bold text-[#1e2a5e] no-underline transition hover:-translate-y-0.5 hover:shadow-xl">
            Make a Donation
          </a>
          <p class="mb-0 max-w-2xl text-sm leading-6 text-white/65 md:text-right">
            Late Diagnosed is an IRS-recognized 501(c)(3) public charity. Donations are tax-deductible to the extent allowed by law.
          </p>
        </div>
      </div>
    </section>

    <!-- Deferred Get Involved sections are tracked in WEB-29, WEB-30, and WEB-31. -->

    <section class="bg-[#faf9fc] px-6 py-16 md:py-20">
      <div class="mx-auto max-w-3xl rounded-2xl border border-slate-200 bg-white px-6 py-8 shadow-sm md:px-8">
        <div class="mb-5">
          <h2 class="font-heading mb-2 text-2xl font-bold text-[#1e2a5e] md:text-3xl">Get email updates</h2>
          <p class="mb-0 text-sm leading-6 text-slate-600">
            Occasional updates about new resources, community surveys, and ways to get involved.
          </p>
        </div>

        <form id="email-updates-form" class="flex flex-col gap-3 sm:flex-row" novalidate>
          <label for="email-updates-address" class="sr-only">Email address</label>
          <input
            id="email-updates-address"
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="Email address"
            class="min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-4 py-3 text-base text-slate-800 outline-none transition focus:border-[#4a2068] focus:ring-2 focus:ring-[#4a2068]/15"
          />
          <button type="submit" class="rounded-lg bg-[#4a2068] px-6 py-3 text-base font-bold text-white transition hover:bg-[#3d1a57] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#4a2068]">
            Sign me up
          </button>
        </form>
        <p class="mb-0 mt-3 text-xs leading-5 text-slate-500">
          For now, signup is completed by email. A direct mailing-list connection is tracked in WEB-32.
        </p>
      </div>
    </section>
  </main>

  <style>
    :global(html) {
      scroll-behavior: smooth;
    }

    main.get-involved {
      padding: 0 !important;
    }

    .get-involved h1,
    .get-involved h2,
    .get-involved h3,
    .get-involved p,
    .get-involved blockquote {
      margin-top: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      :global(html) {
        scroll-behavior: auto;
      }
    }
  </style>

  <script is:inline>
    if (window.lucide) {
      window.lucide.createIcons();
    }

    const emailUpdatesForm = document.getElementById("email-updates-form");
    const emailUpdatesInput = document.getElementById("email-updates-address");

    emailUpdatesForm?.addEventListener("submit", (event) => {
      event.preventDefault();

      if (!(emailUpdatesInput instanceof HTMLInputElement)) return;

      if (!emailUpdatesInput.checkValidity()) {
        emailUpdatesInput.reportValidity();
        return;
      }

      const email = emailUpdatesInput.value.trim();
      const subject = encodeURIComponent("Subscribe me to LateDiagnosed.org email updates");
      const body = encodeURIComponent(`Please add ${email} to LateDiagnosed.org email updates.`);
      window.location.href = `mailto:info@latediagnosed.org?subject=${subject}&body=${body}`;
    });
  </script>
</PublicLayout>