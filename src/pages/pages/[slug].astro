---
import { getCollection, render } from "astro:content";
import PublicLayout from "../../layouts/PublicLayout.astro";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import KeyTakeaways from "../../components/KeyTakeaways.astro";

const pages = await getCollection("pages");
const page = pages.find((candidate) => candidate.id === Astro.params.slug);
if (!page || page.data.status !== "published") return new Response("Not found", { status: 404 });
const { Content } = await render(page);
---

<PublicLayout
  title={page.data.seoTitle || page.data.title}
  description={page.data.seoDescription || page.data.description}
  image={page.data.heroImage}
  canonicalUrl={page.data.canonicalUrl}
  publishDate={page.data.publishDate?.toISOString()}
  modifiedDate={(page.data.lastUpdated || page.data.publishDate)?.toISOString()}
>
  <ArticleLayout
    title={page.data.title}
    description={page.data.description}
    publishDate={page.data.publishDate}
    lastUpdated={page.data.lastUpdated}
  >
    {page.data.keyTakeaways.length > 0 && (
      <KeyTakeaways slot="key-takeaways">
        <ul>
          {page.data.keyTakeaways.map((takeaway) => <li>{takeaway}</li>)}
        </ul>
      </KeyTakeaways>
    )}

    <Content />
  </ArticleLayout>
</PublicLayout>
