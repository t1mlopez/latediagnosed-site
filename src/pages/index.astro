---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/home/Hero.astro";
import Validation from "../components/home/Validation.astro";
import StartHere from "../components/home/StartHere.astro";
import Community from "../components/home/Community.astro";
import Mission from "../components/home/Mission.astro";
import FeaturedArticles from "../components/home/FeaturedArticles.astro";
import ResourceLibrary from "../components/home/ResourceLibrary.astro";
import PractitionerLibrary from "../components/home/PractitionerLibrary.astro";
import Stories from "../components/home/Stories.astro";
import Newsletter from "../components/home/Newsletter.astro";
import Donate from "../components/home/Donate.astro";
import { getCollection } from "astro:content";

const featuredArticles = (await getCollection("articles"))
  .filter((article) => article.data.status === "published" && article.data.featured)
  .sort((a, b) => {
    const aDate = a.data.publishDate ? new Date(a.data.publishDate).getTime() : 0;
    const bDate = b.data.publishDate ? new Date(b.data.publishDate).getTime() : 0;

    return bDate - aDate;
  })
  .slice(0, 3);
const resourceOrder = ["ADHD", "Autism", "AuDHD", "CPTSD"];

const featuredResources = (await getCollection("resources"))
  .filter((resource) => resource.data.status === "published" && resource.data.featured)
  .sort((a, b) => {
    const aIndex = resourceOrder.indexOf(a.data.title);
    const bIndex = resourceOrder.indexOf(b.data.title);

    return (aIndex === -1 ? 999 : aIndex) - (bIndex === -1 ? 999 : bIndex);
  })
  .slice(0, 6);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LateDiagnosed.org</title>
  <script is:inline src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
  <style>
    body { font-family: 'Libre Franklin', sans-serif; }
    .font-heading { font-family: 'Playfair Display', serif; }
    .infinity-symbol { width: 32px; height: 32px; }
  </style>
</head>

<body class="w-full min-h-screen bg-white">
  <!-- Nav -->
  <Header />

  <Hero />

  <Validation />

  <StartHere />

  <Community />

  <Mission />

  <FeaturedArticles featuredArticles={featuredArticles} />

  <ResourceLibrary resources={featuredResources} />

  <PractitionerLibrary />

  <Stories />

  <Newsletter />

  <Donate />

  <Footer />

  <script is:inline>
    if (window.lucide) {
      window.lucide.createIcons();
    }

    const newsletterForm = document.getElementById('newsletter-form');
    const newsletterSuccess = document.getElementById('newsletter-success');

    if (newsletterForm && newsletterSuccess) {
      newsletterForm.addEventListener('submit', function (event) {
        event.preventDefault();
        newsletterForm.classList.add('hidden');
        newsletterSuccess.classList.remove('hidden');
      });
    }
  </script>
</body>
</html>
