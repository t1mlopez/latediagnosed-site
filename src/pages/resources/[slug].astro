---
import { getCollection, render } from "astro:content";
import PublicLayout from "../../layouts/PublicLayout.astro";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import KeyTakeaways from "../../components/KeyTakeaways.astro";

const resources = await getCollection("resources");
const resource = resources.find((candidate) => candidate.id === Astro.params.slug);
if (!resource || resource.data.status !== "published") return new Response("Not found", { status: 404 });
const { Content } = await render(resource);

const articles = await getCollection("articles");
const relatedArticles = articles
  .filter(
    (article) =>
      article.data.status === "published" &&
      article.data.categories?.some((category) =>
        resource.data.categories?.includes(category)
      )
  )
  .sort((a, b) => {
    const aDate = a.data.publishDate ? new Date(a.data.publishDate).getTime() : 0;
    const bDate = b.data.publishDate ? new Date(b.data.publishDate).getTime() : 0;
    return bDate - aDate;
  });
---

<PublicLayout title={resource.data.title}>
  <ArticleLayout
    title={resource.data.title}
    description={resource.data.description}
    author=""
    categories={resource.data.categories}
    publishDate={resource.data.publishDate}
    lastUpdated={resource.data.lastUpdated}
  >
    {resource.data.keyTakeaways.length > 0 && (
      <KeyTakeaways slot="key-takeaways">
        <ul>
          {resource.data.keyTakeaways.map((takeaway) => <li>{takeaway}</li>)}
        </ul>
      </KeyTakeaways>
    )}

    <Content />

    {relatedArticles.length > 0 && (
      <section class="resource-related-section">
        <hr />

        <h2>Related Articles</h2>

        <p>
          Articles connected to {resource.data.title} based on shared categories.
        </p>

        <div class="resource-related-grid">
          {relatedArticles.map((article) => (
            <ArticleCard
              title={article.data.title}
              description={article.data.excerpt || article.data.description}
              categories={article.data.categories}
              href={`/articles/${article.id}/`}
            />
          ))}
        </div>
      </section>
    )}
  </ArticleLayout>
</PublicLayout>
