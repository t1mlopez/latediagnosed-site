---
import PublicLayout from "../layouts/PublicLayout.astro";
---

<PublicLayout
  title="Tell Your Story | Late Diagnosed"
  description="Share your late-diagnosis story with LateDiagnosed.org."
>
  <main class="bg-[#1e2a5e] text-white">
    <header class="border-b border-white/15 bg-[#1e2a5e]">
      <div class="mx-auto max-w-4xl px-6 py-16 md:py-24">
        <h1 class="font-heading mb-5 text-4xl font-bold leading-tight text-white md:text-5xl">Tell your story.</h1>
        <p class="mb-0 max-w-3xl text-xl leading-8 text-white">
          Someone may be where you were six months ago, ten years ago, or yesterday.
        </p>
      </div>
    </header>

    <section class="px-6 py-14 md:py-20">
      <form id="story-form" class="mx-auto max-w-4xl" novalidate>
        <div class="rounded-3xl border border-white/20 bg-[#1e2a5e] p-6 shadow-sm md:p-8">
          <div class="space-y-7">
            <div>
              <label for="credit-name" class="mb-2 block text-sm font-bold text-white">Name <span class="font-normal text-white/75">(optional)</span></label>
              <p class="mb-3 text-sm leading-6 text-white/75">Leave this blank if you would rather have your story shared anonymously.</p>
              <input
                id="credit-name"
                name="creditName"
                type="text"
                autocomplete="name"
                maxlength="120"
                class="w-full rounded-lg border border-white/35 bg-white/10 px-4 py-3 text-base text-white outline-none transition focus:border-white focus:ring-2 focus:ring-white/20"
              />
            </div>

            <div>
              <label for="story" class="mb-2 block text-sm font-bold text-white">Your story</label>
              <textarea
                id="story"
                name="story"
                rows="14"
                maxlength="8000"
                required
                class="w-full rounded-lg border border-white/35 bg-white/10 px-4 py-3 text-base leading-7 text-white outline-none transition focus:border-white focus:ring-2 focus:ring-white/20"
              ></textarea>
            </div>

            <label class="flex items-start gap-3 rounded-2xl bg-white/10 p-5 text-sm leading-6 text-white">
              <input type="checkbox" name="usePermission" class="mt-1 h-4 w-4 shrink-0" />
              <span>
                Late Diagnosed may reshare my story in its nonprofit website, social media, educational materials, awareness, fundraising, and other communications.
              </span>
            </label>

            <div class="flex justify-end border-t border-white/20 pt-6">
              <button
                type="submit"
                class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg border border-white/35 bg-white/10 px-6 py-3 font-bold text-white transition hover:-translate-y-0.5 hover:bg-white/15 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              >
                Send my story <span aria-hidden="true">→</span>
              </button>
            </div>
          </div>
        </div>

        <div id="story-fallback" hidden class="mt-6 rounded-2xl border border-white/20 bg-white/10 p-6 text-white">
          <h2 class="mb-2 text-lg font-bold text-white">Need another way to send it?</h2>
          <p class="mb-4 text-sm leading-6 text-white">
            If your email app didn’t open, copy this and email it to
            <a href="mailto:info@latediagnosed.org" class="font-semibold text-white underline">info@latediagnosed.org</a>.
          </p>
          <textarea id="story-output" readonly rows="14" class="w-full rounded-lg border border-white/35 bg-white/10 px-4 py-3 text-sm leading-6 text-white"></textarea>
          <div class="mt-3 flex items-center gap-3">
            <button id="copy-story" type="button" class="rounded-lg border border-white/35 bg-white/10 px-4 py-2 text-sm font-bold text-white">Copy my story</button>
            <span id="copy-status" class="text-sm text-white" aria-live="polite"></span>
          </div>
        </div>
      </form>
    </section>
  </main>

  <script is:inline>
    if (window.lucide) {
      window.lucide.createIcons();
    }

    const storyForm = document.getElementById("story-form");
    const fallback = document.getElementById("story-fallback");
    const storyOutput = document.getElementById("story-output");
    const copyButton = document.getElementById("copy-story");
    const copyStatus = document.getElementById("copy-status");

    storyForm?.addEventListener("submit", (event) => {
      event.preventDefault();

      if (!(storyForm instanceof HTMLFormElement)) return;
      if (!storyForm.checkValidity()) {
        storyForm.reportValidity();
        return;
      }

      const data = new FormData(storyForm);
      const creditName = String(data.get("creditName") || "").trim();
      const story = String(data.get("story") || "").trim();
      const canReshare = data.get("usePermission") === "on";

      const submission = [
        "TELL YOUR STORY — LateDiagnosed.org",
        "",
        `Credit as: ${creditName || "Anonymous"}`,
        "",
        "STORY",
        story,
        "",
        `Permission to reshare: ${canReshare ? "Yes" : "No"}`,
      ].join("\n");

      if (fallback instanceof HTMLElement) fallback.hidden = false;
      if (storyOutput instanceof HTMLTextAreaElement) storyOutput.value = submission;

      const subject = encodeURIComponent(`Community Story${creditName ? ` - ${creditName}` : ""}`);
      const body = encodeURIComponent(submission);
      window.location.href = `mailto:info@latediagnosed.org?subject=${subject}&body=${body}`;
    });

    copyButton?.addEventListener("click", async () => {
      if (!(storyOutput instanceof HTMLTextAreaElement)) return;

      try {
        await navigator.clipboard.writeText(storyOutput.value);
        if (copyStatus) copyStatus.textContent = "Copied.";
      } catch {
        storyOutput.select();
        document.execCommand("copy");
        if (copyStatus) copyStatus.textContent = "Copied.";
      }
    });
  </script>
</PublicLayout>
