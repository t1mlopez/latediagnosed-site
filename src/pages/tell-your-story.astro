---
import PublicLayout from "../layouts/PublicLayout.astro";
---

<PublicLayout
  title="Tell Your Story | Late Diagnosed"
  description="Share your late-diagnosis story with LateDiagnosed.org."
>
  <main class="bg-white text-slate-700">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-4xl px-6 py-16 md:py-24">
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.16em] text-slate-500">Your story matters</p>
        <h1 class="font-heading mb-5 text-4xl font-bold leading-tight text-[#1e2a5e] md:text-5xl">Tell your story.</h1>
        <p class="mb-4 max-w-3xl text-xl leading-8 text-slate-700">
          Someone may be where you were six months ago, ten years ago, or yesterday.
        </p>
        <p class="mb-0 max-w-3xl text-base leading-7 text-slate-600">
          Share whatever feels important. You do not need to give us a bunch of personal information — we mainly want to hear your experience.
        </p>
      </div>
    </header>

    <section class="px-6 py-14 md:py-20">
      <form id="story-form" class="mx-auto max-w-4xl" novalidate>
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm md:p-8">
          <div class="space-y-7">
            <div>
              <label for="credit-name" class="mb-2 block text-sm font-bold text-slate-700">Name or nickname <span class="font-normal text-slate-500">(optional)</span></label>
              <p class="mb-3 text-sm leading-6 text-slate-500">Leave this blank if you would rather have your story shared anonymously.</p>
              <input
                id="credit-name"
                name="creditName"
                type="text"
                autocomplete="name"
                maxlength="120"
                class="w-full rounded-lg border border-slate-300 px-4 py-3 text-base outline-none transition focus:border-[#1e2a5e] focus:ring-2 focus:ring-[#1e2a5e]/10"
              />
            </div>

            <div>
              <label for="story" class="mb-2 block text-sm font-bold text-slate-700">Your story</label>
              <p class="mb-3 text-sm leading-6 text-slate-500">
                Tell it in your own way. It can be a few sentences or something longer — whatever you want people to understand about your experience.
              </p>
              <textarea
                id="story"
                name="story"
                rows="14"
                maxlength="8000"
                required
                class="w-full rounded-lg border border-slate-300 px-4 py-3 text-base leading-7 outline-none transition focus:border-[#1e2a5e] focus:ring-2 focus:ring-[#1e2a5e]/10"
              ></textarea>
            </div>

            <label class="flex items-start gap-3 rounded-2xl bg-[#faf9fc] p-5 text-sm leading-6 text-slate-700">
              <input type="checkbox" name="usePermission" required class="mt-1 h-4 w-4 shrink-0" />
              <span>
                I give Late Diagnosed permission to use, edit for length or clarity, and share the story I submit in its nonprofit website, social media, educational materials, awareness, fundraising, and other communications. I still own my story.
              </span>
            </label>

            <div class="flex flex-col gap-3 border-t border-slate-200 pt-6 sm:flex-row sm:items-center sm:justify-between">
              <p class="mb-0 max-w-xl text-sm leading-6 text-slate-500">
                We’ll open an email with your story so you can give it one last look before sending.
              </p>
              <button
                type="submit"
                class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg bg-[#1e2a5e] px-6 py-3 font-bold text-white transition hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1e2a5e]"
              >
                Send my story <span aria-hidden="true">→</span>
              </button>
            </div>
          </div>
        </div>

        <div id="story-fallback" hidden class="mt-6 rounded-2xl border border-slate-200 bg-[#faf9fc] p-6">
          <h2 class="mb-2 text-lg font-bold text-slate-800">Need another way to send it?</h2>
          <p class="mb-4 text-sm leading-6 text-slate-700">
            If your email app didn’t open, copy this and email it to
            <a href="mailto:info@latediagnosed.org" class="font-semibold underline">info@latediagnosed.org</a>.
          </p>
          <textarea id="story-output" readonly rows="14" class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm leading-6 text-slate-800"></textarea>
          <div class="mt-3 flex items-center gap-3">
            <button id="copy-story" type="button" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700">Copy my story</button>
            <span id="copy-status" class="text-sm text-slate-600" aria-live="polite"></span>
          </div>
        </div>
      </form>
    </section>
  </main>

  <script is:inline>
    if (window.lucide) {
      window.lucide.createIcons();
    }

    const storyForm = document.getElementById("story-form");
    const fallback = document.getElementById("story-fallback");
    const storyOutput = document.getElementById("story-output");
    const copyButton = document.getElementById("copy-story");
    const copyStatus = document.getElementById("copy-status");

    storyForm?.addEventListener("submit", (event) => {
      event.preventDefault();

      if (!(storyForm instanceof HTMLFormElement)) return;
      if (!storyForm.checkValidity()) {
        storyForm.reportValidity();
        return;
      }

      const data = new FormData(storyForm);
      const creditName = String(data.get("creditName") || "").trim();
      const story = String(data.get("story") || "").trim();

      const submission = [
        "TELL YOUR STORY — LateDiagnosed.org",
        "",
        `Credit as: ${creditName || "Anonymous"}`,
        "",
        "STORY",
        story,
        "",
        "PERMISSION",
        "I give Late Diagnosed permission to use, edit for length or clarity, and share the story I submit in its nonprofit website, social media, educational materials, awareness, fundraising, and other communications. I still own my story.",
      ].join("\n");

      if (fallback instanceof HTMLElement) fallback.hidden = false;
      if (storyOutput instanceof HTMLTextAreaElement) storyOutput.value = submission;

      const subject = encodeURIComponent(`Community Story${creditName ? ` - ${creditName}` : ""}`);
      const body = encodeURIComponent(submission);
      window.location.href = `mailto:info@latediagnosed.org?subject=${subject}&body=${body}`;
    });

    copyButton?.addEventListener("click", async () => {
      if (!(storyOutput instanceof HTMLTextAreaElement)) return;

      try {
        await navigator.clipboard.writeText(storyOutput.value);
        if (copyStatus) copyStatus.textContent = "Copied.";
      } catch {
        storyOutput.select();
        document.execCommand("copy");
        if (copyStatus) copyStatus.textContent = "Copied.";
      }
    });
  </script>
</PublicLayout>
