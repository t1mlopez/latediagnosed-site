---
import PublicLayout from "../layouts/PublicLayout.astro";
---

<PublicLayout title="Search Late Diagnosed">
  <main class="search-page">
    <section class="search-hero">
      <h1>Search Late Diagnosed</h1>
      <p>Search articles, resource hubs, and public pages.</p>

      <label class="sr-only" for="site-search">Search</label>
      <input
        id="site-search"
        type="search"
        placeholder="Search ADHD, autism, CPTSD, masking..."
        autocomplete="off"
      />
    </section>

    <section id="search-results" class="search-results" aria-live="polite">
      <p class="search-empty">Start typing to search the library.</p>
    </section>
  </main>

  <script>
    interface SearchItem {
      url: string;
      type: string;
      title: string;
      description: string;
      keyTakeaways?: string[];
      categories?: string[];
      tags?: string[];
      audience?: string[];
      difficulty?: string;
      body?: string;
    }

    const input = document.querySelector<HTMLInputElement>("#site-search")!;
    const resultsEl = document.querySelector<HTMLElement>("#search-results")!;

    let searchIndex: SearchItem[] = [];

    function normalize(value: unknown): string {
      return String(value || "").toLowerCase();
    }

    function normalizeList(value: unknown): string {
      return Array.isArray(value) ? normalize(value.join(" ")) : "";
    }

    function scoreItem(item: SearchItem, query: string): number {
      const q = normalize(query);

      let score = 0;

      if (normalize(item.title).includes(q)) score += 12;
      if (normalize(item.description).includes(q)) score += 8;
      if (normalizeList(item.keyTakeaways).includes(q)) score += 8;
      if (normalizeList(item.categories).includes(q)) score += 6;
      if (normalizeList(item.tags).includes(q)) score += 4;
      if (normalizeList(item.audience).includes(q)) score += 3;
      if (normalize(item.difficulty).includes(q)) score += 3;
      if (normalize(item.body).includes(q)) score += 1;

      return score;
    }

    function renderResults(items: SearchItem[], query: string) {
      if (!query.trim()) {
        resultsEl.innerHTML = '<p class="search-empty">Start typing to search the library.</p>';
        return;
      }

      if (items.length === 0) {
        resultsEl.innerHTML = '<p class="search-empty">No matching results found.</p>';
        return;
      }

      resultsEl.innerHTML = `
        <p class="search-count">${items.length} result${items.length === 1 ? "" : "s"} found</p>

        <div class="search-result-list">
          ${items
            .map(
              (item) => `
                <a class="search-result-card" href="${item.url}">
                  <span class="search-result-type">${item.type}</span>
                  <h2>${item.title}</h2>
                  <p>${item.description}</p>
                  ${
                    Array.isArray(item.categories) && item.categories.length
                      ? `<div class="search-result-tags">${item.categories
                          .map((category) => `<span>${category}</span>`)
                          .join("")}</div>`
                      : ""
                  }
                </a>
              `
            )
            .join("")}
        </div>
      `;
    }

    async function initSearch() {
      const response = await fetch("/search.json");
      searchIndex = await response.json() as SearchItem[];

      input.addEventListener("input", () => {
        const query = input.value;

        const results = searchIndex
          .map((item) => ({
            ...item,
            score: scoreItem(item, query),
          }))
          .filter((item) => item.score > 0)
          .sort((a, b) => b.score - a.score)
          .slice(0, 20);

        renderResults(results, query);
      });
    }

    initSearch();
  </script>
</PublicLayout>
