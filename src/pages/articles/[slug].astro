---
import { getCollection } from "astro:content";
import PublicLayout from "../../layouts/PublicLayout.astro";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import KeyTakeaways from "../../components/KeyTakeaways.astro";
import ResearchCallout from "../../components/ResearchCallout.astro";
import TipBox from "../../components/TipBox.astro";
import WarningBox from "../../components/WarningBox.astro";
import DefinitionBox from "../../components/DefinitionBox.astro";
import PullQuote from "../../components/PullQuote.astro";
import FAQ from "../../components/FAQ.astro";
import References from "../../components/References.astro";
import DownloadBox from "../../components/DownloadBox.astro";
import TableOfContents from "../../components/TableOfContents.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  const authors = await getCollection("authors");

  return articles
    .filter((article) => article.data.status === "published")
    .map((article) => {
      const author = authors.find((a) => a.id === article.data.author);

      const relatedArticles = articles
        .filter((candidate) => {
          if (candidate.id === article.id) return false;
          if (candidate.data.status !== "published") return false;

          const sharedCategories = candidate.data.categories?.some((category) =>
            article.data.categories?.includes(category)
          );

          const sharedTags = candidate.data.tags?.some((tag) =>
            article.data.tags?.includes(tag)
          );

          return sharedCategories || sharedTags;
        })
        .sort((a, b) => {
          const aDate = a.data.publishDate
            ? new Date(a.data.publishDate).getTime()
            : 0;

          const bDate = b.data.publishDate
            ? new Date(b.data.publishDate).getTime()
            : 0;

          return bDate - aDate;
        })
        .slice(0, 3);

      return {
        params: { slug: article.id },
        props: {
          article,
          author,
          relatedArticles,
        },
      };
    });
}

const { article, author, relatedArticles } = Astro.props;

const wordCount = article.body
  ? article.body.trim().split(/\s+/).length
  : 0;

const minutes = Math.max(1, Math.ceil(wordCount / 225));
const readingTime = `${minutes} min read`;
const headings = article.rendered?.metadata?.headings ?? [];

const isComponentShowcase = article.id === "component-showcase";
---

<PublicLayout
  title={article.data.seoTitle || article.data.title}
  description={article.data.seoDescription || article.data.description}
  image={article.data.heroImage}
  canonicalUrl={article.data.canonicalUrl}
  type="Article"
author={author?.data?.name}
publishDate={article.data.publishDate?.toISOString()}
modifiedDate={(article.data.lastUpdated || article.data.publishDate)?.toISOString()}
>
  <ArticleLayout
    title={article.data.title}
    description={article.data.description}
    author={author?.data?.name}
    categories={article.data.categories}
    publishDate={article.data.publishDate}
    lastUpdated={article.data.lastUpdated}
    readingTime={readingTime}
    difficulty={article.data.difficulty}
    audience={article.data.audience}
    reviewedBy={article.data.reviewedBy}
    reviewDate={article.data.reviewDate}
    hasPdf={article.data.hasPdf}
    pdfUrl={article.data.pdfUrl}
    hasAudio={article.data.hasAudio}
    audioUrl={article.data.audioUrl}
    hasVideo={article.data.hasVideo}
    videoUrl={article.data.videoUrl}
  >
    <KeyTakeaways>
      <ul>
        <li>This article is placeholder content.</li>
        <li>The template now supports reusable summary blocks.</li>
        <li>Future articles can use this space for quick reader orientation.</li>
      </ul>
    </KeyTakeaways>

    {isComponentShowcase && (
      <>
        <ResearchCallout>
          Research-backed information goes here.
        </ResearchCallout>

        <TipBox>
          Practical advice goes here.
        </TipBox>

        <WarningBox>
          This is an important warning.
        </WarningBox>

        <DefinitionBox term="Executive Function">
          Executive function is the brain's management system.
        </DefinitionBox>

        <PullQuote attribution="Late Diagnosed">
          Understanding yourself changes how you understand your past.
        </PullQuote>

        <FAQ question="Can adults have ADHD without knowing?">
          <p>Yes. Many people are diagnosed in adulthood.</p>
        </FAQ>

        <DownloadBox title="Printable Checklist">
          Download a PDF version.
        </DownloadBox>

        <References>
          <ul>
            <li>Example reference.</li>
          </ul>
        </References>
      </>
    )}

    <div set:html={article.rendered.html} />

    {relatedArticles.length > 0 && (
      <section class="related-articles-section">
        <hr />

        <h2>Related Articles</h2>

        <div class="related-articles-grid">
          {relatedArticles.map((relatedArticle) => (
            <ArticleCard
              title={relatedArticle.data.title}
              description={relatedArticle.data.excerpt || relatedArticle.data.description}
              categories={relatedArticle.data.categories}
              href={`/articles/${relatedArticle.id}/`}
            />
          ))}
        </div>
      </section>
    )}

    <TableOfContents slot="sidebar" headings={headings} />
  </ArticleLayout>
</PublicLayout>
