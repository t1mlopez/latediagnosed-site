<!-- Hero -->
  <header class="relative w-full overflow-hidden min-h-[70vh]">
    <picture>
      <source
        media="(max-width: 767px)"
        srcset="/images/hero-forest-1280.webp"
        type="image/webp"
      />
      <img
        class="absolute inset-0 w-full h-full object-cover object-center"
        src="/images/hero-forest-2560.webp"
        alt="Sunlight filtering through a misty autumn forest"
        width="2560"
        height="1920"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-r from-[#1e2a5eee] to-[#4a2068cc]"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 flex flex-col justify-center min-h-[70vh] py-24">
      <h1 class="font-heading text-white mb-4 text-4xl md:text-5xl font-bold max-w-4xl">
        Understanding yourself changes everything
      </h1>
      <p class="text-white/90 text-lg max-w-2xl mb-8">
        Supporting adults navigating late diagnosis of ADHD, Autism, AuDHD, Complex PTSD, Borderline Personality Disorder, Dissociative Disorders, burnout, and related neurodivergent experiences.
      </p>
      <a href="#start-here" class="inline-block w-fit px-6 py-3 rounded-lg font-semibold bg-white text-[#1e2a5e] no-underline">
        Start Here
      </a>
    </div>
  </header>
