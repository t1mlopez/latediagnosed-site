---
import HeroSlide from '../HeroSlide.astro';
export const title = 'Giving yourself grace';
const { first = true } = Astro.props;
---
<HeroSlide
  heading="The shame was never yours to carry"
  description="You don’t have to feel deserving to begin giving yourself grace. Explore what you knew, what you could control, and what you were trying to survive."
  href="/articles/giving-yourself-grace-when-the-shame-was-never-yours-to-carry/"
  button="Read the article"
  image="/images/hero-grace-2560.webp"
  mobileImage="/images/hero-grace-1280.webp"
  alt="A leafy tree beside a red barn beneath a sweeping blue sky"
  height={1361}
  position="75% 70%"
  first={first}
/>
