---
import HomeActionCard from "./HomeActionCard.astro";

const cards = [
  {
    href: "/resources/just-diagnosed/",
    icon: "compass",
    title: "Just Diagnosed?",
    description: "A gentle guide to your first days and weeks after receiving a diagnosis. What to expect, what's normal, and how to take care of yourself.",
    accent: "navy" as const,
  },
  {
    href: "/resources/suspect-adhd-or-autism/",
    icon: "help-circle",
    title: "Suspect ADHD or Autism?",
    description: "Exploring the possibility of neurodivergence? Learn about common signs in adults, self-assessment tools, and how to seek evaluation.",
    accent: "purple" as const,
  },
  {
    href: "/resources/understanding-masking-burnout/",
    icon: "eye-off",
    title: "Understanding Masking & Burnout",
    description: "Why you've been exhausted for years. Learn about masking, autistic burnout, ADHD burnout, and how to begin unmasking safely.",
    accent: "navy" as const,
  },
  {
    href: "/resources/finding-assessments-and-support/",
    icon: "clipboard-list",
    title: "Finding Assessments & Support",
    description: "Navigate the assessment process, find neurodivergent-affirming clinicians, and understand your options for formal and informal identification.",
    accent: "purple" as const,
  },
  {
    href: "/resources/late-diagnosis-depression/",
    icon: "users",
    title: "Late Diagnosis Depression",
    description: "Receiving a late diagnosis can bring clarity, but it can also challenge how you understand your past experiences and your sense of self.",
    accent: "navy" as const,
  },
  {
    href: "/resources/frequently-asked-questions/",
    icon: "message-circle",
    title: "Frequently Asked Questions",
    description: "Answers to common questions about late diagnosis, including \"Am I too old?\", \"Is self-diagnosis valid?\", and more.",
    accent: "purple" as const,
  },
];
---

<!-- Start Here -->
<section id="start-here" class="max-w-6xl mx-auto px-6 py-20">
  <div class="text-center mb-12">
    <h2 class="font-heading mb-4 text-[#1e2a5e] font-bold text-3xl">Start Here</h2>
    <p class="text-lg text-gray-700">Not sure where to begin? Choose the path that feels most relevant to you right now.</p>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {cards.map((card) => <HomeActionCard {...card} />)}
  </div>
</section>
