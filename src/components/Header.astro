---
const menuItems = [
  { href: "/", label: "Home" },
  {
    label: "Start Here",
    children: [
      { href: "/resources/just-diagnosed/", label: "Just Diagnosed?" },
      {
        href: "/resources/suspect-adhd-or-autism/",
        label: "Suspect ADHD or Autism?",
      },
      {
        href: "/resources/understanding-masking-burnout/",
        label: "Understanding Masking & Burnout",
      },
      {
        href: "/resources/finding-assessments-and-support/",
        label: "Finding Assessments & Support",
      },
      {
        href: "/resources/late-diagnosis-depression/",
        label: "Late Diagnosis Depression",
      },
      {
        href: "/resources/frequently-asked-questions/",
        label: "Frequently Asked Questions",
      },
    ],
  },
  {
    label: "Guides",
    children: [
      {
        href: "/articles/welcome-to-adhd/",
        label: "Welcome to Late Diagnosis ADHD",
      },
    ],
  },
  { href: "/search", label: "Search", iconOnly: true },
  {
    href: "https://discord.gg/rYUKq96WqJ",
    label: "Community",
    external: true,
  },
  { href: "/about", label: "About Us" },
  {
    href: "https://givebutter.com/late-diagnosed-donations-3akmpq",
    label: "Donate",
    external: true,
  },
];

const user = Astro.locals.user;
---

<header class="w-full bg-white border-b border-gray-100 sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between relative">
    <a
      href="/"
      class="font-heading text-xl font-bold text-[#1e2a5e] no-underline"
    >
      LateDiagnosed.org
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm" aria-label="Primary navigation">
      {menuItems.map((item) => (
        item.children ? (
          <div class="relative group">
            <button
              type="button"
              class="flex items-center gap-1 text-gray-600 hover:text-[#1e2a5e] focus:text-[#1e2a5e]"
              aria-haspopup="true"
            >
              {item.label}
              <span aria-hidden="true">▾</span>
            </button>
            <div
              class="invisible absolute left-0 top-full z-50 min-w-64 pt-3 opacity-0 transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
            >
              <div class="rounded-md border border-gray-100 bg-white py-2 shadow-lg">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class="block whitespace-nowrap px-4 py-2 text-gray-600 hover:bg-gray-50 hover:text-[#1e2a5e]"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : item.iconOnly ? (
          <a
            href={item.href}
            aria-label={item.label}
            title={item.label}
            class="inline-flex items-center justify-center text-gray-600 hover:text-[#1e2a5e]"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
          </a>
        ) : (
          <a
            href={item.href}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
            class="text-gray-600 hover:text-[#1e2a5e]"
          >
            {item.label}
          </a>
        )
      ))}
      {user ? (
        <>
          <a href="/account" class="font-semibold text-[#1e2a5e]">Account</a>
          <form action="/auth/logout" method="post">
            <button type="submit" class="cursor-pointer text-gray-600 hover:text-[#1e2a5e]">Sign out</button>
          </form>
        </>
      ) : (
        <a href="/auth/login" class="font-semibold text-[#1e2a5e]">Sign in</a>
      )}
    </nav>

    <details class="group md:hidden text-sm">
      <summary
        class="cursor-pointer list-none rounded-md px-3 py-2 font-bold text-[#1e2a5e] hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1e2a5e] [&::-webkit-details-marker]:hidden"
      >
        Menu
        <span class="inline-block ml-1 transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
      </summary>

      <nav
        class="absolute left-0 right-0 top-full flex flex-col border-t border-gray-100 bg-white px-6 py-2 shadow-lg"
        aria-label="Mobile primary navigation"
      >
        {menuItems.map((item) => (
          item.children ? (
            <div class="border-b border-gray-100 py-3">
              <div class="font-medium text-gray-600">{item.label}</div>
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class="mt-2 block pl-4 text-gray-600 hover:text-[#1e2a5e]"
                >
                  {child.label}
                </a>
              ))}
            </div>
          ) : item.iconOnly ? (
            <a
              href={item.href}
              aria-label={item.label}
              title={item.label}
              class="flex w-fit items-center border-b border-gray-100 py-3 text-gray-600 hover:text-[#1e2a5e]"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-5 w-5"
              >
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
            </a>
          ) : (
            <a
              href={item.href}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
              class="border-b border-gray-100 py-3 text-gray-600 last:border-b-0 hover:text-[#1e2a5e]"
            >
              {item.label}
            </a>
          )
        ))}
        {user ? (
          <>
            <a href="/account" class="border-b border-gray-100 py-3 font-semibold text-[#1e2a5e]">Account</a>
            <form action="/auth/logout" method="post" class="py-3">
              <button type="submit" class="cursor-pointer text-gray-600">Sign out</button>
            </form>
          </>
        ) : (
          <a href="/auth/login" class="py-3 font-semibold text-[#1e2a5e]">Sign in</a>
        )}
      </nav>
    </details>
  </div>
</header>
