---
interface Props {
  title: string;
  description: string;
  author?: string;
  categories?: string[];
  publishDate?: Date;
  lastUpdated?: Date;
  readingTime?: string;

  difficulty?: "beginner" | "intermediate" | "advanced";
  audience?: string[];
  reviewedBy?: string;
  reviewDate?: Date;

  hasPdf?: boolean;
  pdfUrl?: string;

  hasAudio?: boolean;
  audioUrl?: string;

  hasVideo?: boolean;
  videoUrl?: string;
}

const {
  title,
  description,
  author,
  categories = [],
  publishDate,
  lastUpdated,

  difficulty,

  hasPdf,
  pdfUrl,

  hasAudio,
  audioUrl,

  hasVideo,
  videoUrl,
} = Astro.props;

const formattedPublishDate = publishDate?.toLocaleDateString();
const formattedUpdatedDate = lastUpdated?.toLocaleDateString();

const hasMediaLinks =
  (hasPdf && pdfUrl) ||
  (hasAudio && audioUrl) ||
  (hasVideo && videoUrl);
---

<section class="article-hero">
  <div class="article-hero-inner">
    {categories.length > 0 && (
      <div class="article-categories">
        {categories.map((category) => (
          <span class="category-pill">{category}</span>
        ))}
      </div>
    )}

    <h1>{title}</h1>

    <p class="article-description">
      {description}
    </p>

    {(author || difficulty || formattedPublishDate || formattedUpdatedDate) && (
      <div class="article-meta">
        {author && <span>By {author}</span>}
        {difficulty && <span>{difficulty}</span>}
        {(formattedPublishDate || formattedUpdatedDate) && (
          <div class="article-dates">
            {formattedPublishDate && <span>Published {formattedPublishDate}</span>}
            {formattedUpdatedDate && <span>Updated {formattedUpdatedDate}</span>}
          </div>
        )}
      </div>
    )}

    {hasMediaLinks && (
      <div class="article-extra-meta">
        <div class="article-media-links">
          {hasPdf && pdfUrl && <a href={pdfUrl}>PDF</a>}
          {hasAudio && audioUrl && <a href={audioUrl}>Audio</a>}
          {hasVideo && videoUrl && <a href={videoUrl}>Video</a>}
        </div>
      </div>
    )}
  </div>
</section>

<main class="article-shell">
  <article class="article-main">
    <slot name="key-takeaways" />

    <div class="article-content">
      <slot />
    </div>
  </article>

  <aside class="article-sidebar">
    <slot name="sidebar" />
  </aside>
</main>
