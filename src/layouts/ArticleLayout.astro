---
interface Props {
  title: string;
  description: string;
  author?: string;
  categories?: string[];
  publishDate?: Date;
  lastUpdated?: Date;
  readingTime?: string;
}

const {
  title,
  description,
  author,
  categories = [],
  publishDate,
  lastUpdated,
  readingTime,
} = Astro.props;

const formattedPublishDate = publishDate?.toLocaleDateString();
const formattedUpdatedDate = lastUpdated?.toLocaleDateString();
---

<section class="article-hero">
  <div class="article-hero-inner">
    {categories.length > 0 && (
      <div class="article-categories">
        {categories.map((category) => (
          <span class="category-pill">{category}</span>
        ))}
      </div>
    )}

    <h1>{title}</h1>

    <p class="article-description">
      {description}
    </p>

    <div class="article-meta">
      {author && <span>By {author}</span>}
      {readingTime && <span>{readingTime}</span>}
      {formattedPublishDate && <span>Published {formattedPublishDate}</span>}
      {formattedUpdatedDate && <span>Updated {formattedUpdatedDate}</span>}
    </div>
  </div>
</section>

<main class="article-shell">
  <article class="article-main">
    <div class="article-content">
      <slot />
    </div>
  </article>

  <aside class="article-sidebar">
    <slot name="sidebar" />
  </aside>
</main>