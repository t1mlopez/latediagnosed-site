---
interface Props {
  title: string;
  description: string;
  author?: string;
  categories?: string[];
  publishDate?: Date;
  lastUpdated?: Date;
  readingTime?: string;

  difficulty?: "beginner" | "intermediate" | "advanced";
  audience?: string[];
  reviewedBy?: string;
  reviewDate?: Date;

  hasPdf?: boolean;
  pdfUrl?: string;

  hasAudio?: boolean;
  audioUrl?: string;

  hasVideo?: boolean;
  videoUrl?: string;
}

const {
  title,
  description,
  author,
  categories = [],
  publishDate,
  lastUpdated,
  readingTime,

  difficulty,
  audience = [],
  reviewedBy,
  reviewDate,

  hasPdf,
  pdfUrl,

  hasAudio,
  audioUrl,

  hasVideo,
  videoUrl,
} = Astro.props;

const formattedPublishDate = publishDate?.toLocaleDateString();
const formattedUpdatedDate = lastUpdated?.toLocaleDateString();
const formattedReviewDate = reviewDate?.toLocaleDateString();

const hasMediaLinks =
  (hasPdf && pdfUrl) ||
  (hasAudio && audioUrl) ||
  (hasVideo && videoUrl);
---

<section class="article-hero">
  <div class="article-hero-inner">
    {categories.length > 0 && (
      <div class="article-categories">
        {categories.map((category) => (
          <span class="category-pill">{category}</span>
        ))}
      </div>
    )}

    <h1>{title}</h1>

    <p class="article-description">
      {description}
    </p>

    <div class="article-meta">
      {author && <span>By {author}</span>}
      {readingTime && <span>{readingTime}</span>}
      {difficulty && <span>{difficulty}</span>}
      {formattedPublishDate && <span>Published {formattedPublishDate}</span>}
      {formattedUpdatedDate && <span>Updated {formattedUpdatedDate}</span>}
    </div>

    {(audience.length > 0 || reviewedBy || formattedReviewDate || hasMediaLinks) && (
      <div class="article-extra-meta">
        {audience.length > 0 && (
          <div>
            <strong>Audience:</strong> {audience.join(", ")}
          </div>
        )}

        {(reviewedBy || formattedReviewDate) && (
          <div>
            <strong>Reviewed:</strong>{" "}
            {reviewedBy && <span>{reviewedBy}</span>}
            {reviewedBy && formattedReviewDate && <span> · </span>}
            {formattedReviewDate && <span>{formattedReviewDate}</span>}
          </div>
        )}

        {hasMediaLinks && (
          <div class="article-media-links">
            {hasPdf && pdfUrl && <a href={pdfUrl}>PDF</a>}
            {hasAudio && audioUrl && <a href={audioUrl}>Audio</a>}
            {hasVideo && videoUrl && <a href={videoUrl}>Video</a>}
          </div>
        )}
      </div>
    )}
  </div>
</section>

<main class="article-shell">
  <article class="article-main">
    <slot name="key-takeaways" />

    <div class="article-content">
      <slot />
    </div>
  </article>

  <aside class="article-sidebar">
    <slot name="sidebar" />
  </aside>
</main>
